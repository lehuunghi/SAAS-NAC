# Mau chuan bi production cho nac20.com; chua tu bat trien khai.
# Dien bi mat tren may chu, khong commit .env thuc te.
# NAC_DOMAIN la vung DNS de xuat cho may NAC rieng, can cau hinh va xac nhan.
APP_NAME="NAC20 Cloud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nac20.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_nac
DB_USERNAME=saas_nac
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=2700
CACHE_STORE=redis
CACHE_PREFIX=saas_nac_production_
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TN20"
PASSWORD_RECOVERY_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
PROVISIONING_DRIVER=manual
PROVISIONING_ENABLED=false
SSH_INSTALL_ENABLED=false
NAC_DOMAIN=nac.nac20.com
NAC_ARTIFACT_URL=
NAC_ARTIFACT_SHA256=
ANSIBLE_BINARY=/usr/bin/ansible-playbook
PROVISIONING_SSH_KEY=
PROVISIONING_KNOWN_HOSTS=
HCLOUD_TOKEN=
HCLOUD_SERVER_TYPE=
HCLOUD_LOCATION=
HCLOUD_SSH_KEY_ID=
HCLOUD_FIREWALL_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOMER_REGISTRATION_ENABLED=false
BANK_PAYMENT_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
MYSQL_ROOT_PASSWORD=
SESSION_COOKIE=nac20_production_session
